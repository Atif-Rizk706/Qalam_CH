    {
      "name": "Protected User Library",
      "item": [
        {
          "name": "Get User Library (Favorites/Shelf/History)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/library",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Toggle Favorite",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/library/favorites",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"book_id\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Toggle Shelf",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/library/shelf",
            "header": [
              {
